generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(uuid())
  username       String   @unique
  email          String?   @unique
  phoneNumber    String   @unique
  passwordHash   String
  role           Role     @default(PARENT)
  emailVerified  Boolean  @default(false)
  fullName       String
  gender         Gender?
  city           String?
  subCity        String?
  woreda         String?
  village        String?
  profilePicture String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  students                        Student[]
  documentsReviewed               ApplicationDocument[]    @relation("DocumentReviewer")
  emailVerificationTokens         EmailVerificationToken[]
  invitationVerificationsReviewed InvitationVerification[] @relation("InvitationReviewer")
  refreshTokens                   RefreshToken[]
  reviewedApplications            TutorApplication[]       @relation("ApplicationReviewer")
  tutorApplications               TutorApplication[]
  applicationReviewsWritten       TutorApplicationReview[] @relation("ApplicationReviewAuthor")
  createdOffers                   Offer[]
  offerApplications               OfferApplication[]
}

model Student {
  id                   String   @id @default(uuid())
  parentId             String
  fullName             String
  gradeId              String
  preferredGender      Gender? // MALE, FEMALE, or null for ANY
  preferredMinAge      Int?
  preferredMaxAge      Int?
  requireCertification Boolean  @default(false)
  additionalNotes      String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Relations
  parent       User                 @relation(fields: [parentId], references: [id], onDelete: Cascade)
  grade        Grade                @relation(fields: [gradeId], references: [id])
  weakSubjects StudentWeakSubject[]
  offers       Offer[]

  @@index([parentId])
  @@index([gradeId])
}

model StudentWeakSubject {
  studentId String
  subjectId String
  gradeId   String
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id])
  grade   Grade   @relation(fields: [gradeId], references: [id])

  @@id([studentId, subjectId, gradeId])
  @@index([subjectId])
  @@index([gradeId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model TutorApplication {
  id                      String                            @id @default(uuid())
  userId                  String
  educationStatus         EducationStatus
  status                  TutorApplicationStatus            @default(DRAFT)
  submittedAt             DateTime?
  reviewedAt              DateTime?
  reviewedById            String?
  createdAt               DateTime                          @default(now())
  updatedAt               DateTime                          @updatedAt
  documents               ApplicationDocument[]
  additionalSkills        ApplicationSkill[]
  invitationVerifications InvitationVerification[]
  reviewer                User?                             @relation("ApplicationReviewer", fields: [reviewedById], references: [id])
  user                    User                              @relation(fields: [userId], references: [id])
  excludedSubjects        TutorApplicationExcludedSubject[]
  teachableGrades         TutorApplicationGrade[]
  preferredGrades         TutorApplicationPreferredGrade[]
  reviewHistory           TutorApplicationReview[]
  teachableSubjects       TutorApplicationSubject[]

  @@index([userId])
  @@index([status])
  @@index([educationStatus])
  @@index([reviewedById])
}

model Subject {
  id           String                            @id @default(uuid())
  name         String                            @unique
  isActive     Boolean                           @default(true)
  createdAt    DateTime                          @default(now())
  updatedAt    DateTime                          @updatedAt
  excludedBy   TutorApplicationExcludedSubject[]
  teachableBy  TutorApplicationSubject[]
  offers       OfferSubject[]
  weakSubjects StudentWeakSubject[]

  @@index([isActive])
}

model TutorApplicationSubject {
  applicationId String
  subjectId     String
  createdAt     DateTime         @default(now())
  application   TutorApplication @relation(fields: [applicationId], references: [id])
  subject       Subject          @relation(fields: [subjectId], references: [id])

  @@id([applicationId, subjectId])
  @@index([subjectId])
}

model TutorApplicationExcludedSubject {
  applicationId String
  subjectId     String
  createdAt     DateTime         @default(now())
  application   TutorApplication @relation(fields: [applicationId], references: [id])
  subject       Subject          @relation(fields: [subjectId], references: [id])

  @@id([applicationId, subjectId])
  @@index([subjectId])
}

model Offer {
  id          String      @id @default(uuid())
  createdById String
  studentId   String
  gradeId     String
  description String?
  city        String
  subCity     String
  woreda      String?
  village     String?
  schedule    String
  monthlyPay  Decimal     @db.Decimal(10, 2)
  status      OfferStatus @default(OPEN)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  creator      User               @relation(fields: [createdById], references: [id])
  student      Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  grade        Grade              @relation(fields: [gradeId], references: [id])
  subjects     OfferSubject[]
  applications OfferApplication[]

  @@index([createdById])
  @@index([studentId])
  @@index([status])
  @@index([gradeId])
  @@index([city, subCity])
}

model OfferSubject {
  offerId   String
  subjectId String

  offer   Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id])

  @@id([offerId, subjectId])
  @@index([subjectId])
}

model OfferApplication {
  id        String                 @id @default(uuid())
  offerId   String
  tutorId   String
  status    OfferApplicationStatus @default(PENDING)
  appliedAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  offer Offer @relation(fields: [offerId], references: [id])
  tutor User  @relation(fields: [tutorId], references: [id])

  @@unique([offerId, tutorId])
  @@index([tutorId])
  @@index([status])
}

model Grade {
  id        String     @id @default(uuid())
  name      String     @unique
  level     GradeLevel @default(SCHOOL)
  sortOrder Int        @unique
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  teachableBy  TutorApplicationGrade[]
  preferredBy  TutorApplicationPreferredGrade[]
  students     Student[]
  offers       Offer[]
  weakSubjects StudentWeakSubject[]

  @@index([isActive])
  @@index([level])
}

model TutorApplicationGrade {
  applicationId String
  gradeId       String
  createdAt     DateTime         @default(now())
  application   TutorApplication @relation(fields: [applicationId], references: [id])
  grade         Grade            @relation(fields: [gradeId], references: [id])

  @@id([applicationId, gradeId])
  @@index([gradeId])
}

model TutorApplicationPreferredGrade {
  applicationId String
  gradeId       String
  createdAt     DateTime         @default(now())
  application   TutorApplication @relation(fields: [applicationId], references: [id])
  grade         Grade            @relation(fields: [gradeId], references: [id])

  @@id([applicationId, gradeId])
  @@index([gradeId])
}

model ApplicationDocument {
  id                 String                     @id @default(uuid())
  applicationId      String
  type               ApplicationDocumentType
  title              String?
  storageKey         String                     @unique
  originalFilename   String
  mimeType           String
  sizeBytes          Int
  verificationStatus DocumentVerificationStatus @default(PENDING)
  verificationNote   String?
  verifiedAt         DateTime?
  reviewedById       String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  application        TutorApplication           @relation(fields: [applicationId], references: [id])
  reviewer           User?                      @relation("DocumentReviewer", fields: [reviewedById], references: [id])

  @@index([applicationId])
  @@index([applicationId, type])
  @@index([verificationStatus])
}

model ApplicationSkill {
  id            String           @id @default(uuid())
  applicationId String
  name          String
  description   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  application   TutorApplication @relation(fields: [applicationId], references: [id])

  @@index([applicationId])
}

model InvitationVerification {
  id                 String                       @id @default(uuid())
  applicationId      String
  type               InvitationType
  claimedCount       Int                          @default(0)
  status             InvitationVerificationStatus @default(PENDING)
  evidenceStorageKey String?
  reviewNote         String?
  reviewedAt         DateTime?
  reviewedById       String?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  application        TutorApplication             @relation(fields: [applicationId], references: [id])
  reviewer           User?                        @relation("InvitationReviewer", fields: [reviewedById], references: [id])

  @@unique([applicationId, type])
  @@index([status])
  @@index([reviewedById])
}

model TutorApplicationReview {
  id            String                 @id @default(uuid())
  applicationId String
  reviewerId    String
  status        TutorApplicationStatus
  note          String?
  createdAt     DateTime               @default(now())
  application   TutorApplication       @relation(fields: [applicationId], references: [id])
  reviewer      User                   @relation("ApplicationReviewAuthor", fields: [reviewerId], references: [id])

  @@index([applicationId, createdAt])
  @@index([reviewerId])
}

enum Role {
  ADMIN
  PARENT
  TUTOR
}

enum Gender {
  MALE
  FEMALE
}

enum EducationStatus {
  NONGRADUATE
  GRADUATE
}

enum TutorApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum OfferStatus {
  OPEN
  FILLED
  CANCELLED
}

enum OfferApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum GradeLevel {
  KINDERGARTEN
  SCHOOL
  UNIVERSITY
}

enum ApplicationDocumentType {
  TRANSCRIPT_GRADE_9_12
  NATIONAL_EXAM_GRADE_10
  NATIONAL_EXAM_GRADE_12
  TUTORING_CV
  KEBELE_ID
  STUDENT_ID
  NATIONAL_ID
  DIPLOMA_CERTIFICATE
  DEGREE_CERTIFICATE
  ADDITIONAL_CERTIFICATE
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum InvitationType {
  TELEGRAM_MEMBERS
  APP_INVITATIONS
}

enum InvitationVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}
